generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id         Int               @id @default(autoincrement())
  legacyId   Int?              @unique
  legacyPath String?           @unique
  parentId   Int?
  parent     Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]        @relation("CategoryTree")
  name       String
  slug       String            @unique
  position   Int               @default(0)
  isActive   Boolean           @default(true)
  products   ProductCategory[]
}

model Product {
  id              Int               @id @default(autoincrement())
  legacyId        Int?              @unique
  sku             String            @unique
  legacyCode      String?
  slug            String            @unique
  name            String
  brand           String?
  descriptionHtml String            @default("")
  descriptionText String            @default("")
  price           Int
  salePrice       Int?
  saleStartsAt    DateTime?
  saleEndsAt      DateTime?
  flashSaleId     Int?
  stockQty        Int               @default(0)
  stockStatus     String            @default("in_stock") // in_stock | out_of_stock | special_order
  rxClass         String            @default("otc") // otc | pom (prescription-only)
  status          String            @default("active") // active | draft | archived
  featured        Boolean           @default(false)
  metaTitle       String?
  metaDescription String?
  needsReview     Boolean           @default(false)
  reviewNote      String?
  ratingAvg       Float             @default(0)
  ratingCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  flashSale       FlashSale?        @relation(fields: [flashSaleId], references: [id], onDelete: SetNull)
  reviews         Review[]
  tags            ProductTag[]
  images          ProductImage[]
  categories      ProductCategory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]

  @@index([status])
  @@index([name])
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  originalUrl String?
  alt         String?
  position    Int     @default(0)

  @@index([productId])
  @@index([originalUrl])
}

model ProductCategory {
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// Extra legacy redirects (duplicates merged, demo product removed, etc.)
model Redirect {
  from String @id
  to   String
  hits Int    @default(0)
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  phone         String?
  name          String
  passwordHash  String
  role          String         @default("customer") // customer | pharmacist | admin
  isActive      Boolean        @default(true)
  county        String?
  town          String?
  area          String?
  street        String?
  apartment     String?
  addressType   String?
  notificationsSeenAt DateTime? // staff: when the order notifications were last read
  avatar        String? // profile picture (/uploads/...)
  createdAt     DateTime       @default(now())
  reviews       Review[]
  carts         Cart[]
  orders        Order[]
  prescriptions Prescription[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int

  @@unique([cartId, productId])
}

model Order {
  id            Int           @id @default(autoincrement())
  number        String        @unique
  accessToken   String
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])
  name          String
  email         String
  phone         String
  county        String
  town          String
  address       String
  notes         String?
  deliveryZone  String
  subtotal      Int
  discount      Int           @default(0)
  couponCode    String?
  deliveryFee   Int
  total         Int
  deliverySlot  String?
  addressType   String?
  status        String // awaiting_rx | pending_payment | paid | processing | shipped | delivered | cancelled
  paymentStatus String        @default("unpaid") // unpaid | pending | paid | failed
  rxStatus      String        @default("not_required") // not_required | pending | approved | rejected
  rxNote        String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  prescription  Prescription?

  @@index([status])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  price     Int
  qty       Int
  rxClass   String   @default("otc")
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String // ipay (older rows: mpesa | paystack)
  amount    Int
  status    String   @default("pending") // pending | paid | failed
  reference String   @unique // iPay invoice (inv), e.g. HH2611241234-A1B2C3
  receipt   String?
  phone     String?
  message   String?
  raw       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id])
  filePath     String
  originalName String
  mimeType     String
  status       String    @default("pending") // pending | approved | rejected
  reviewedBy   String?
  reviewedAt   DateTime?
  note         String?
  createdAt    DateTime  @default(now())
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // sale | restock | adjustment | cancel
  orderId   Int?
  userEmail String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  rating    Int
  comment   String
  verified  Boolean  @default(false)
  status    String   @default("published") // published | pending | hidden
  createdAt DateTime @default(now())

  @@index([productId])
}

model Tag {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  products  ProductTag[]
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
}

model Refund {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  method    String   @default("mpesa") // mpesa | card | other
  status    String   @default("requested") // requested | approved | refunded | rejected
  reference String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  title      String
  type       String    @default("percent") // percent | fixed
  value      Int
  minOrder   Int       @default(0)
  maxDiscount Int?
  usageLimit Int?
  used       Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model FlashSale {
  id          Int       @id @default(autoincrement())
  title       String
  discountPct Int
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Page {
  id        Int      @id @default(autoincrement())
  kind      String // faq | privacy | terms
  title     String
  content   String
  position  Int      @default(0)
  status    String   @default("published") // published | draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model Setting {
  key   String @id
  value String
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  kind      String   @default("contact") // contact | feedback
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  orderId   Int?
  status    String   @default("new") // new | read | replied
  createdAt DateTime @default(now())
}

/// Delivery options shown at checkout (managed in Admin → Settings → Shipping).
model ShippingMethod {
  id           Int      @id @default(autoincrement())
  group        String // heading at checkout, e.g. "Flat Rate", "Pickup"
  title        String // e.g. "Flat Shipping Rate"
  note         String   @default("") // e.g. "Delivered in 1–3 days"
  fee          Int      @default(0) // KES
  freeOver     Boolean  @default(true) // free when the order reaches the free-delivery amount
  needsAddress Boolean  @default(true) // false for store pickup
  isActive     Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Home Page Control: hero slides and promo banners on the shop's home page.
model HomeBlock {
  id        Int       @id @default(autoincrement())
  name      String // admin label, e.g. "Vitamins slide"
  slug      String    @unique
  type      String // hero | promo
  isActive  Boolean   @default(true)
  position  Int       @default(0)
  tag       String    @default("") // small line above the title (hero)
  badge     String    @default("") // pill next to the tag (hero)
  title     String
  text      String    @default("")
  ctaLabel  String    @default("Shop Now")
  href      String    @default("/search")
  image     String? // /uploads/... or /img/w/... product photo
  bgColor   String    @default("#ffe9d6") // promo card background
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
