DATABASE_URL="file:./healthhub.db"
APP_URL="http://localhost:3000"
AUTH_SECRET="change-me-to-a-long-random-string"

# Delivery: orders above this amount (KES) get free delivery
FREE_DELIVERY_OVER=5000

# iPay Africa (M-Pesa, Airtel Money, Visa/Mastercard). From your iPay merchant account.
# Leave blank to use the development test page (never in production).
IPAY_VENDOR_ID=""
IPAY_HASH_KEY=""
# 1 = real payments, 0 = iPay test mode
IPAY_LIVE="0"

# Store details shown in the footer
STORE_PHONE="+254 704 191 509"
PPB_LICENCE_NO=""

# Email (order confirmations, password resets, contact form). Any SMTP provider works.
# Leave empty in development: emails are written to the server log instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Health Hub Chemist <orders@healthhub.ke>"

# Cloudflare Turnstile (free CAPTCHA) for sign-up, contact, password reset and repeated failed logins.
# Get keys at dash.cloudflare.com → Turnstile → Add site. Leave empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
